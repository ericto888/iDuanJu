				<array>
					<string>idjplugin</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.ericto888.idjplugin</string>
			</dict>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
	</array>
